STACK_NAME=virtualizarr-data-pipelines
STAGE="dev"
GARBAGE_COLLECTION_FREQUENCY=2

# Forward SQS consumer. Leave unset to default: enabled normally, but disabled
# automatically when BACKFILL_ENABLED=true (so the backfill bootstraps main first).
# After the backfill promotes, set FORWARD_QUEUE_ENABLED=true and redeploy.
# FORWARD_QUEUE_ENABLED=false

STAGE=dev
ACCOUNT_ID=
ACCOUNT_REGION=us-west-2
# Region of the Icechunk bucket. Only needed when it is not in ACCOUNT_REGION;
# left unset, icechunk resolves the region from the running handler.
# ICECHUNK_REGION=
# Bucket for backfill artifacts: inventory, partition manifests and forks.
# Created when BACKFILL_ENABLED. Must be in ACCOUNT_REGION, which is why it is
# not the Icechunk bucket. Bucket names are globally unique, so set your own.
# BACKFILL_BUCKET_NAME=
# BACKFILL_BUCKET=
# Garbage collection runs in an AWS Batch cluster inside a VPC.
# Enabling it requires BOTH of the following, and `cdk synth` will then
# perform a VPC lookup that needs real AWS credentials for ACCOUNT_ID.
# GARBAGE_COLLECTION_FREQUENCY=2
# VPC_ID=vpc-0123456789abcdef0

# HLS L30 tile cube. Defaults shown; LP DAAC direct S3 access needs us-west-2.
# MGRS_TILE=T13SDA
# HLS_PRODUCT=L30
# LPDAAC_ACCESS=s3
# Secrets Manager secret holding {"username", "password"} for Earthdata login.
# Granted only to backfill init/worker and the forward process_messages Lambda.
# EARTHDATA_SECRET_ARN=
# Chunk-ref cache size; ~8,010 refs per granule, scale with BACKFILL_PARTITION_SIZE.
# ICECHUNK_NUM_CHUNK_REFS=5000000
